# Local ports. Change these only when the defaults conflict with your machine.
# Dev compose exposes frontend, backend, Neo4j, and MinIO inspection ports.
FRONTEND_PORT=8080
INLUMEN_API_PORT=5001

# Public backend URL used by the browser frontend. Leave blank for local development.
# Use a full URL such as https://api.example.com; local shorthand like localhost:5001 is accepted.
INLUMEN_API_PUBLIC_URL=

# Database/admin console ports exposed by docker-compose.yml for local development.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
MINIO_S3_PORT=9000
MINIO_CONSOLE_PORT=9099

# Local development credentials.
NEO4J_AUTH=neo4j/password
MINIO_ROOT_USER=minio-datapact
MINIO_ROOT_PASSWORD=minio-datapact

# Public API authentication token used when AUTH_ENABLED=false.
API_AUTH_TOKEN=change-me-local-token

# Authentication is off by default. If you set AUTH_ENABLED=true, fill in the
# Keycloak values below; Docker Compose mirrors this switch to the frontend.
AUTH_ENABLED=false
KEYCLOAK_JWKS_URL=
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=inlumen
VITE_KEYCLOAK_CLIENT_ID=inlumen-frontend
VITE_ENABLE_REMOTE_CHATBOT_CONFIG_SYNC=true

# Backend development file watcher.
WATCH_INTERVAL_SECONDS=1.0

# Optional SemT service discovery. Without a base URL, inLUMEN exposes the
# adapters supported by the installed semt_py contract as a local catalog.
SEMT_API_BASE_URL=
SEMT_API_TOKEN=
SEMT_CATALOG_TIMEOUT_SECONDS=5
SEMT_CATALOG_CACHE_TTL_SECONDS=300

# Optional Moose service metadata. The API key remains server-side and is
# referenced from node configurations through connection_ref.
MOOSE_API_BASE_URL=
MOOSE_API_KEY=
MOOSE_API_TIMEOUT_SECONDS=5
MOOSE_CATALOG_CACHE_TTL_SECONDS=300

# OCI registry namespace used to identify generated immutable SemT images.
# Image builds are local for the current milestone; pushing is a future step.
INLUMEN_IMAGE_REGISTRY=ghcr.io
