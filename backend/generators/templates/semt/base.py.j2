# Propagated from the input envelope (set by main())
_DATASET_ID = ""
_TABLE_ID = ""
METADATA_SUFFIX = "__semt_metadata"
TABLE_METADATA_COLUMN = "__inlumen_table_metadata"

logging.basicConfig(
