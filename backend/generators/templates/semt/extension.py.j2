# ---------------------------------------------------------------------------
# Extension-specific helpers
# ---------------------------------------------------------------------------

def _build_extension_other_params() -> dict[str, Any]:
    """Build other_params from catalog parameters not handled by the core API."""
    other: dict[str, Any] = {}
    for key, value in PARAMETERS.items():
        if key in (
            "api_base_url", "username", "password", "token",
            "dataset_id", "table_id", "connection_ref",
            "column_name", "properties", "extra_key_columns",
        ):
            continue
        if isinstance(value, (dict, list)):
            other[key] = value
        elif isinstance(value, bool):
            other[key] = value
        elif isinstance(value, (int, float)):
            other[key] = value
        elif isinstance(value, str) and value.strip():
            other[key] = value
    return other


def _backend_extend(
    table: dict[str, Any],
    dataset_id: str,
    table_id: str,
    extender_id: str,
    column_name: str,
    properties: list[str],
    other_params: dict[str, Any],
) -> dict[str, Any]:
    """Perform extension via the SemT backend: fetch → extend → push."""
    base_url = _resolve_api_base_url()
    auth_manager = build_auth_manager()

    extension_manager = ExtensionManager(base_url.rstrip("/"), auth_manager)
    table_manager = TableManager(base_url.rstrip("/"), auth_manager)
    utility = Utility(base_url.rstrip("/"), auth_manager)

    LOGGER.info("Fetching table %s from dataset %s", table_id, dataset_id)
    table_data = table_manager.get_table(dataset_id, table_id)
    if not isinstance(table_data, dict):
        raise RuntimeError(
            f"Failed to retrieve table {table_id} from dataset {dataset_id}."
        )

    LOGGER.info(
        "Extending column=%s  extender=%s  properties=%s",
        column_name, extender_id,
        json.dumps(properties),
    )
    extended_table, extension_payload = extension_manager.extend_column(
        table=table_data,
        column_name=column_name,
        extender_id=extender_id,
        properties=properties,
        other_params=other_params,
        deduplicate=True,
        extra_key_columns=list(PARAMETERS.get("extra_key_columns") or []),
    )

    if not isinstance(extended_table, dict):
        raise RuntimeError("SemT extension returned no table.")

    LOGGER.info("Pushing extended table back to backend ...")
    success_msg, _ = utility.push_to_backend(
        dataset_id, table_id, extension_payload
    )
    LOGGER.info(success_msg)

    return extended_table


# ---------------------------------------------------------------------------
# Operation entry point
# ---------------------------------------------------------------------------

def execute_operation(table: dict[str, Any]) -> dict[str, Any]:
    """Extend a column using a SemT extender service.

    In backend mode (dataset_id + table_id available) the table is
    fetched from / pushed to the SemT backend automatically.
    In file mode the table is extended locally (legacy / testing).
    """
    extender_id = SERVICE_ID
    column_name = str(PARAMETERS.get("column_name") or "")
    properties = list(PARAMETERS.get("properties") or [])
    other_params = _build_extension_other_params()
    extra_key_columns = list(PARAMETERS.get("extra_key_columns") or [])

    dataset_id = _DATASET_ID or str(PARAMETERS.get("dataset_id") or "").strip()
    table_id = _TABLE_ID or str(PARAMETERS.get("table_id") or "").strip()

    if dataset_id and table_id:
        return _backend_extend(
            table, dataset_id, table_id,
            extender_id, column_name,
            properties, other_params,
        )

    # ── File-based mode (legacy / tests) ────────────────────────────────
    auth_manager = build_auth_manager()
    manager = ExtensionManager(_resolve_api_base_url(), auth_manager)
    result, _extension_payload = manager.extend_column(
        table=table,
        column_name=column_name,
        extender_id=extender_id,
        properties=properties,
        other_params=other_params,
        deduplicate=True,
        extra_key_columns=extra_key_columns,
    )
    if not isinstance(result, dict):
        raise RuntimeError("SemT extension returned no table.")
    return result
